<section>
  <h1 class="page-title">poems</h1>

  <div class="page-list poems-list">
    <% @poems.each do |poem| %>
      <button
        type="button"
        class="page-list-item poem-trigger"
        data-title="<%= poem[:title] %>"
        data-year="<%= poem[:year] %>"
        data-body="<%= poem[:body].to_s.gsub(/"/, '&quot;') %>"
      >
        <div>
          <div class="page-list-title"><%= poem[:title] %></div>
          <div class="page-list-meta"><%= poem[:year] %></div>
        </div>
        <div class="page-list-meta">—</div>
      </button>
    <% end %>
  </div>
</section>

<div class="poem-modal" id="poem-modal" aria-hidden="true">
  <div class="poem-modal-backdrop" data-close="true"></div>
  <div class="poem-modal-card" role="dialog" aria-modal="true" aria-labelledby="poem-modal-title">
    <button class="poem-modal-close" type="button" aria-label="Close poem">×</button>
    <div class="poem-modal-meta" id="poem-modal-year"></div>
    <h2 id="poem-modal-title"></h2>
    <div class="poem-modal-body" id="poem-modal-body"></div>
  </div>
</div>

<script>
  const poemModal = document.getElementById('poem-modal');
  const poemTitle = document.getElementById('poem-modal-title');
  const poemYear = document.getElementById('poem-modal-year');
  const poemBody = document.getElementById('poem-modal-body');
  const triggerButtons = document.querySelectorAll('.poem-trigger');

  const openPoem = (title, year, body) => {
    poemTitle.textContent = title;
    poemYear.textContent = year;
    poemBody.textContent = body;
    poemModal.classList.add('is-open');
    poemModal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closePoem = () => {
    poemModal.classList.remove('is-open');
    poemModal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  triggerButtons.forEach((button) => {
    button.addEventListener('click', () => {
      openPoem(
        button.dataset.title,
        button.dataset.year,
        button.dataset.body
      );
    });
  });

  poemModal.addEventListener('click', (event) => {
    if (event.target instanceof HTMLElement && event.target.dataset.close === 'true') {
      closePoem();
    }
  });

  document.querySelector('.poem-modal-close')?.addEventListener('click', closePoem);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && poemModal.classList.contains('is-open')) {
      closePoem();
    }
  });
</script>
