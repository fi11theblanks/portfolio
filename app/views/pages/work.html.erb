<% content_for :head do %>
  <%= stylesheet_link_tag 'pages/work', media: 'all' %>
<% end %>

<section>
  <h1 class="page-title">work</h1>
  <div class="page-cards work-list">
    <% @work.each do |item| %>
      <button
        type="button"
        class="card work-trigger <%= 'work-trigger--with-photo' if item[:photo].to_s.present? %>"
        style="<%= "background-image: url('#{item[:photo]}');" if item[:photo].to_s.present? %>"
        data-title="<%= item[:title] %>"
        data-type="<%= item[:type] %>"
        data-year="<%= item[:year] %>"
        data-location="<%= item[:location] %>"
        data-photo="<%= item[:photo].to_s %>"
        data-link="<%= item[:link].to_s %>"
      >
        <div class="work-item-copy">
          <h3><%= item[:title] %></h3>
          <p class="page-list-meta"><%= item[:type] %></p>
          <p class="page-list-meta"><%= item[:year] %> · <%= item[:location] %></p>
        </div>
      </button>
    <% end %>
  </div>
</section>

<div class="work-modal" id="work-modal" aria-hidden="true">
  <div class="work-modal-backdrop" data-close="true"></div>
  <div class="work-modal-card" role="dialog" aria-modal="true" aria-labelledby="work-modal-title">
    <button class="work-modal-close" type="button" aria-label="Close work">×</button>
    <div class="work-modal-photo-wrap" id="work-modal-photo-wrap">
      <img id="work-modal-photo" alt="Project detail" />
    </div>
    <div class="work-modal-meta" id="work-modal-meta"></div>
    <h2 id="work-modal-title"></h2>
    <div class="work-modal-link-row" id="work-modal-link-row"></div>
  </div>
</div>

<script>
  const workModal = document.getElementById('work-modal');
  const workTitle = document.getElementById('work-modal-title');
  const workMeta = document.getElementById('work-modal-meta');
  const workLinkRow = document.getElementById('work-modal-link-row');
  const workPhoto = document.getElementById('work-modal-photo');
  const workPhotoWrap = document.getElementById('work-modal-photo-wrap');
  const workTriggers = document.querySelectorAll('.work-trigger');

  const openWork = (title, type, year, location, photo, link) => {
    workTitle.textContent = title;
    workMeta.textContent = `${type} · ${year} · ${location}`;
    workLinkRow.innerHTML = link
      ? `<a href="${link}" target="_blank" rel="noopener noreferrer" aria-label="Open ${title} in a new tab">↗ open project</a>`
      : '';

    if (photo) {
      workPhoto.src = photo;
      workPhotoWrap.style.display = 'block';
    } else {
      workPhoto.removeAttribute('src');
      workPhotoWrap.style.display = 'none';
    }

    workModal.classList.add('is-open');
    workModal.setAttribute('aria-hidden', 'false');
  };

  const closeWork = () => {
    workModal.classList.remove('is-open');
    workModal.setAttribute('aria-hidden', 'true');
  };

  workTriggers.forEach((button) => {
    button.addEventListener('click', () => {
      openWork(
        button.dataset.title,
        button.dataset.type,
        button.dataset.year,
        button.dataset.location,
        button.dataset.photo,
        button.dataset.link
      );
    });
  });

  workModal.addEventListener('click', (event) => {
    if (event.target instanceof HTMLElement && event.target.dataset.close === 'true') {
      closeWork();
    }
  });

  document.querySelector('.work-modal-close')?.addEventListener('click', closeWork);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && workModal.classList.contains('is-open')) {
      closeWork();
    }
  });
</script>
