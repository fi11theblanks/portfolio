<% content_for :head do %>
  <%= stylesheet_link_tag 'pages/contact', media: 'all' %>
<% end %>

<section>
  <h1 class="page-title">contact me</h1>
  <div class="contact-grid">
    <div>
      <h3>send a message, introduce yourself. please dont forget to include your email address, socials or phone number.</h3>
      <%= form_with url: contact_path, method: :post, local: true do |f| %>
        <div class="form-row">
          <label><noframes></noframes>name</label>
          <%= f.text_field :name, required: true, autocomplete: "name" %>
        </div>

        <div class="form-row">
          <label>subject</label>
          <%= f.text_field :subject, autocomplete: "off" %>
        </div>

        <div class="form-row">
          <label>message</label>
          <%= f.text_area :message, rows: 6, required: true %>
        </div>

        <div class="form-row">
          <%= f.submit "Send", class: "button" %>
        </div>
      <% end %>
    </div>
    <div>
      <h3>based</h3>
      <p class="card-text">Tbilisi, GE</p>
      <p class="page-list-meta">for now at least</p>
    </div>
  </div>
</section>
