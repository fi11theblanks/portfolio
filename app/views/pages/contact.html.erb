<% content_for :head do %>
  <%= stylesheet_link_tag 'pages/contact', media: 'all' %>
<% end %>

<section>
  <h1 class="page-title">Contact</h1>
  <div class="contact-grid">
    <div>
      <h3>Send a message</h3>
      <%= form_with url: contact_path, method: :post, local: true do |f| %>
        <div class="form-row">
          <label>Name</label>
          <%= f.text_field :name, required: true, autocomplete: "name" %>
        </div>

        <div class="form-row">
          <label>Subject</label>
          <%= f.text_field :subject, autocomplete: "off" %>
        </div>

        <div class="form-row">
          <label>Message</label>
          <%= f.text_area :message, rows: 6, required: true %>
        </div>

        <div class="form-row">
          <%= f.submit "Open mailbox", class: "button" %>
        </div>
      <% end %>
    </div>
    <div>
      <h3>Elsewhere</h3>
      <div class="contact-list">
        <a href="#">Bandcamp</a>
        <a href="#">SoundCloud</a>
        <a href="#">Letterboxd</a>
      </div>
    </div>
    <div>
      <h3>Based</h3>
      <p class="card-text">Tblisi, GE</p>
      <p class="page-list-meta">available for travel</p>
    </div>
  </div>
</section>
